{
  "name": "@processdynamics/components",
  "version": "0.1.8",
  "description": "Process Dynamics React component library, built on shadcn (Radix) and Tailwind CSS v4.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IncredibleMrTim/pd-design-system.git"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm build:storybook-site && next build",
    "start": "next start",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:storybook-site": "rm -rf public/storybook && storybook build -o storybook-static && mv storybook-static public/storybook",
    "build:lib": "tsup && node scripts/buildStyles.mjs",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "release:guard": "node scripts/checkReleaseBranch.mjs",
    "release:check": "pnpm exec tsc --noEmit && pnpm lint && pnpm exec vitest run && npm whoami",
    "release:dry": "pnpm release:check && pnpm publish --dry-run",
    "release": "pnpm release:guard && pnpm release:check && pnpm publish",
    "prepublishOnly": "pnpm build:lib",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4",
    "@vitest/coverage-v8": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-storybook": "^10.6.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "playwright": "latest",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "storybook": "^10.6.5",
    "tailwindcss": "^4",
    "tsup": "^9.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "latest",
    "vitest": "^4"
  },
  "packageManager": "pnpm@10.6.5",
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8"
  }
}
